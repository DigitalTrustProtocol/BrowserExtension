{
  "name": "attentionx",
  "private": true,
  "version": "0.1.0",
  "description": "A Nostr-backed context and feedback layer for X timelines.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --config vite.page.config.ts && vite build --config vite.content.config.ts && vite build --config vite.nip07-inject.config.ts && vite build --config vite.nip07-bridge.config.ts",
    "postbuild": "node scripts/reload-extension.mjs",
    "go": "node scripts/dev-browser-go.mjs",
    "reload-extension": "node scripts/reload-extension.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "i18next": "^26.3.6",
    "idb": "^8.0.3",
    "nostr-tools": "^2.24.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-force-graph-2d": "^1.29.1",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "chrome-types": "^0.1.436",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.52.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
